diff --git a/dist/core/server-islands/vite-plugin-server-islands.js b/dist/core/server-islands/vite-plugin-server-islands.js
index d76b16113bfe83c096f67aaed26cbdfac4d9ee70..bb388e2bdf8ffb1f9aad5b2a9b6703ea3cc6897b 100644
--- a/dist/core/server-islands/vite-plugin-server-islands.js
+++ b/dist/core/server-islands/vite-plugin-server-islands.js
@@ -110,8 +110,15 @@ export const serverIslandNameMap = ${serverIslandPlaceholderNameMap};`
         if (serverIslandsState.hasIslands()) {
           for (const env of serverEnvironments) {
             const mod = env.moduleGraph.getModuleById(RESOLVED_SERVER_ISLAND_MANIFEST);
-            if (mod) {
-              env.moduleGraph.invalidateModule(mod);
+            // Patched: reset only this module instead of `invalidateModule(mod)`. It's consumed via a
+            // dynamic `import()` (manifest.serverIslandMappings), so dropping its transform result is
+            // enough for the next import to get the fresh map. `invalidateModule` also cascades to
+            // importers — with the Cloudflare adapter that's Astro's pre-bundled runtime, `astro:actions`
+            // and nearly every component — so each first-time .astro transform made the worker
+            // re-evaluate them mid-request and concurrent requests got partial exports (`actions` undefined).
+            if (mod?.transformResult) {
+              env.moduleGraph.etagToModuleMap?.delete(mod.transformResult.etag);
+              mod.transformResult = null;
             }
           }
         }
